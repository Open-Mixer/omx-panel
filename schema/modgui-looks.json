{
  "$comment": "The MOD GUI's looks, declared once (tools/look.mjs emits them into tools/look.json; tools/modgui-gen.mjs wears one). Every look sets every token of one schema: its backgrounds and shadows are CSS, `{--role}` names a colour role of look-roles.json at its one default, and `{--enclosure}` the plugin's own enclosure colour from the look's palette (picked by the plugin's name). A plate that carries text (the head, the section, the key, the screen) is held by tools/look-contrast.mjs: its stops, and the enclosure palette where the text sits on the body itself, against every text colour (the `--t-*` tokens) set on it. The vintage look is the owner's reference: a cream enclosure, a dark label plate, black knobs with a white pointer, dark recessed screens with an amber curve, a red bypass LED and a chrome footswitch. `none` draws nothing. The `console` look is the console's flat look, byte for byte what the MOD GUI was before the looks. `{console:--token}` is one of the four tokens of the OpenMixer console's vintage glass (the glass, its grid, the legend, the orange accent), pinned at one console commit in tools/look/console-vintage.json (tools/look-pin.mjs) and set into tools/look.json by tools/look.mjs: the vintage screens' values are the console's, never retyped.",
  "setting": {
    "name": "modgui-look",
    "values": [
      "vintage",
      "console",
      "3d"
    ],
    "default": "vintage",
    "env": "OMX_MODGUI_LOOK",
    "flag": "--look"
  },
  "tierSetting": {
    "name": "modgui-tier",
    "values": [
      "easy",
      "advanced"
    ],
    "default": "advanced",
    "env": "OMX_MODGUI_TIER",
    "flag": "--tier"
  },
  "looks": {
    "vintage": {
      "--enclosure": "#e9dfc7",
      "--body-bg": "radial-gradient(140% 90% at 30% 0%, #f6efdd, {--enclosure} 55%, #cfc2a3)",
      "--body-shadow": "inset 0 2px 0 rgba(255,255,255,0.6), inset 0 -3px 0 rgba(90,70,40,0.25), 0 16px 26px rgba(0,0,0,0.6)",
      "--head-bg": "linear-gradient(180deg, #2c2924, #1b1916)",
      "--section-bg": "none",
      "--section-shadow": "{console:--shadow-1}, inset 0 1px 0 rgba(255,255,255,0.5)",
      "--key-bg": "{finish:--btn-face}",
      "--key-shadow": "inset 0 1px 0 {finish:--knob-cap-hi}, {console:--shadow-1}",
      "--key-pressed-bg": "{console:--accent}",
      "--key-held-bg": "{console:--glass}",
      "--key-pressed-shadow": "inset 0 1px 3px rgba(0,0,0,0.6)",
      "--led-off": "radial-gradient(circle at 35% 30%, #6b4a44, #2a1512)",
      "--led-on-bg": "radial-gradient(circle at 35% 30%, #ffd2c8 0, #e8442d 45%, #7a160b)",
      "--led-on-shadow": "0 0 9px 2px rgba(232,68,45,0.6), 0 0 0 2px #1c1a16",
      "--led-left": "-20px",
      "--screen-bg": "linear-gradient({console:--glass-grid} 1px, transparent 1px) 0 0 / 100% 12px, linear-gradient(90deg, {console:--glass-grid} 1px, transparent 1px) 0 0 / 12px 100%, {console:--glass}",
      "--screen-shadow": "{console:--inset-track}, 0 1px 0 rgba(255,255,255,0.12)",
      "--bypass-bg": "radial-gradient(circle at 40% 30%, {finish:--knob-cap-hi}, {finish:--knob-face} 60%, {finish:--knob-knurl})",
      "--bypass-shadow": "{console:--shadow-1}, 0 0 0 2px {finish:--knob-edge}, inset 0 -2px 3px rgba(0,0,0,0.35)",
      "--knob": "knob-vintage.svg",
      "--t-brand": "{console:--cap-legend}",
      "--t-label": "#f3ead4",
      "--t-section": "{console:--ink-dim-light}",
      "--t-control": "{console:--ink-light}",
      "--t-value": "{console:--ink-light}",
      "--t-key": "{console:--cap-legend}",
      "--t-list-sel": "{--accent}",
      "--t-screen": "{console:--legend}",
      "--t-screen-dim": "{console:--legend}",
      "--curve-line": "{console:--accent}",
      "--head-inset": "5px 10px",
      "--head-rule": "none",
      "--screws": "radial-gradient(circle at 40% 35%, {finish:--knob-cap-hi}, {finish:--screw})",
      "--body-radius": "14",
      "--label-font": "Gelasio, Georgia, \"Times New Roman\", serif",
      "--control-caps": "uppercase",
      "--scribble-bg": "{console:--glass}",
      "--scribble-ink": "{console:--accent}",
      "--scribble-glow": "0 0 6px 1px {console:--accent}",
      "--scribble-shadow": "{console:--inset-track}, 0 1px 0 rgba(255,255,255,0.55)",
      "--screws-shadow": "{console:--shadow-1}",
      "--screws-slot": "{console:--shade}",
      "--finish": "{console:default-finish}",
      "--fader": "fader-vintage.svg",
      "--switch-track": "{console:--glass}",
      "--switch-thumb": "{finish:--toggle-face}",
      "--switch-shadow": "{console:--inset-track}",
      "--vu-bezel": "3px solid {console:--glass}",
      "--accent-bar-glow": "none"
    },
    "console": {
      "--enclosure": "{--surface}",
      "--body-bg": "{--surface}",
      "--body-shadow": "inset 0 0 0 1px {--border-strong}",
      "--head-bg": "none",
      "--section-bg": "{--surface-2}",
      "--section-shadow": "none",
      "--key-bg": "{--surface-3}",
      "--key-shadow": "none",
      "--key-pressed-bg": "{--accent}",
      "--key-held-bg": "none",
      "--key-pressed-shadow": "none",
      "--led-off": "{--surface-3}",
      "--led-on-bg": "{--accent}",
      "--led-on-shadow": "none",
      "--led-left": "none",
      "--screen-bg": "{--surface-3}",
      "--screen-shadow": "none",
      "--bypass-bg": "none",
      "--bypass-shadow": "none",
      "--knob": "flat",
      "--t-brand": "{--ink-dim}",
      "--t-label": "{--ink}",
      "--t-section": "{--ink-dim}",
      "--t-control": "{--ink-dim}",
      "--t-value": "{--ink}",
      "--t-key": "{--ink}",
      "--t-list-sel": "{--accent}",
      "--t-screen": "{--ink}",
      "--t-screen-dim": "{--ink-dim}",
      "--curve-line": "{--curve-stroke}",
      "--head-inset": "none",
      "--head-rule": "{--accent}",
      "--screws": "none",
      "--body-radius": "none",
      "--label-font": "none",
      "--control-caps": "none",
      "--scribble-bg": "#0f1317",
      "--scribble-ink": "{--accent}",
      "--scribble-glow": "none",
      "--scribble-shadow": "inset 0 0 0 1px {--border-strong}",
      "--screws-shadow": "none",
      "--screws-slot": "none",
      "--finish": "none",
      "--fader": "flat",
      "--switch-track": "{--surface-3}",
      "--switch-thumb": "{--ink-dim}",
      "--switch-shadow": "none",
      "--vu-bezel": "1px solid {--border-strong}",
      "--accent-bar-glow": "none"
    },
    "3d": {
      "--enclosure": "{--surface}",
      "--body-bg": "linear-gradient(180deg, {--surface} 0%, {--glass} 100%)",
      "--body-shadow": "inset 0 1px 0 rgba(255,255,255,0.14), inset 0 0 0 1px {--border-strong}, inset 0 -2px 0 rgba(0,0,0,0.45), 0 8px 18px rgba(0,0,0,0.55)",
      "--head-bg": "none",
      "--section-bg": "linear-gradient(180deg, {--surface-2} 0%, {--surface} 100%)",
      "--section-shadow": "0 2px 0 {--glass}, 0 4px 8px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.10)",
      "--key-bg": "linear-gradient(180deg, {--surface-3} 0%, {--surface-2} 100%)",
      "--key-shadow": "0 2px 0 {--glass}, 0 3px 5px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.12)",
      "--key-pressed-bg": "{--accent}",
      "--key-held-bg": "{--surface-2}",
      "--key-pressed-shadow": "inset 0 2px 4px rgba(0,0,0,0.55), 0 1px 0 rgba(255,255,255,0.08)",
      "--led-off": "{--glass}",
      "--led-on-bg": "{--accent}",
      "--led-on-shadow": "0 0 8px 2px {--accent}",
      "--led-left": "none",
      "--screen-bg": "linear-gradient(180deg, {--glass} 0%, {--surface-3} 100%)",
      "--screen-shadow": "inset 0 3px 6px rgba(0,0,0,0.6), 0 1px 0 rgba(255,255,255,0.06)",
      "--bypass-bg": "linear-gradient(180deg, {--surface-3} 0%, {--surface-2} 100%)",
      "--bypass-shadow": "0 2px 0 {--glass}, 0 3px 5px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.12)",
      "--knob": "knob-3d.svg",
      "--t-brand": "{--ink-dim}",
      "--t-label": "{--ink}",
      "--t-section": "{--ink-dim}",
      "--t-control": "{--ink-dim}",
      "--t-value": "{--ink}",
      "--t-key": "{--ink}",
      "--t-list-sel": "{--accent}",
      "--t-screen": "{--ink}",
      "--t-screen-dim": "{--ink-dim}",
      "--curve-line": "{--curve-stroke}",
      "--head-inset": "none",
      "--head-rule": "{--accent}",
      "--screws": "none",
      "--body-radius": "none",
      "--label-font": "none",
      "--control-caps": "none",
      "--scribble-bg": "linear-gradient(180deg, #0a0d10, #12171b)",
      "--scribble-ink": "#7ee8f7",
      "--scribble-glow": "0 0 4px rgba(40,200,230,0.6)",
      "--scribble-shadow": "inset 0 2px 3px rgba(0,0,0,0.85), 0 1px 0 rgba(255,255,255,0.06)",
      "--screws-shadow": "none",
      "--screws-slot": "none",
      "--finish": "none",
      "--fader": "flat",
      "--switch-track": "linear-gradient(180deg, {--surface-3} 0%, {--surface-2} 100%)",
      "--switch-thumb": "{--ink-dim}",
      "--switch-shadow": "0 2px 0 {--glass}, 0 3px 5px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.12)",
      "--vu-bezel": "1px solid {--border-strong}",
      "--accent-bar-glow": "0 2px 10px 0 {--accent}"
    }
  }
}
