{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmixer.org/schema/omx-panel/main/control-kind-vectors.schema.json",
  "title": "omx-panel control-kind vectors",
  "description": "The conformance vectors of the kind of a scanned control (docs/control-kind.md): one row per case, what the plugin states and the kind the rule gives. GPL-3.0-or-later.",
  "type": "object",
  "required": [
    "$schema",
    "doc",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "doc": {
      "type": "string",
      "minLength": 1
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "$defs": {
    "scale": {
      "enum": [
        "linear",
        "log",
        "stepped",
        "unknown"
      ]
    },
    "row": {
      "type": "object",
      "required": [
        "id",
        "stated",
        "expect",
        "why"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "stated": {
          "$ref": "#/$defs/stated"
        },
        "expect": {
          "$ref": "#/$defs/expect"
        },
        "why": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stated": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false,
      "properties": {
        "enumeration": {
          "type": "boolean"
        },
        "toggled": {
          "type": "boolean"
        },
        "stepped": {
          "type": "boolean"
        },
        "scale": {
          "$ref": "#/$defs/scale"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "minimum": 0
        },
        "default": {
          "type": "number"
        }
      }
    },
    "expect": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "choice"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "toggle"
            },
            "default": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "scale"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "travel"
            },
            "scale": {
              "$ref": "#/$defs/scale"
            }
          }
        }
      ]
    }
  }
}
