prefix=@PREFIX@
libdir=@LIBDIR@
includedir=@INCLUDEDIR@

Name: omx-panel-ui
Description: A plugin's own panel for a host's GUI protocol (CLAP clap.gui, LV2 ui:X11UI): bound to its parameters, in a window
Version: @VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -lomx-panel-ui
