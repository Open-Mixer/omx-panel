# The omx-panel sync pass is enabled by default where systemd exists (docs/descriptions-store.md section 14, 5), with
# its path watch and its daily timer; nothing depends on them, and omx-panel-sync run by hand does the same work.
enable omx-panel-sync.service
enable omx-panel-sync.path
enable omx-panel-sync.timer
