#
# The ABI of include/omx-panel/omx_panel_store.h in libomx-panel-store.so.0: each exported function with the symbol
# version it is bound to, one per line, and its C prototype after the colon. Adding a line is a minor addition; changing or
# removing one moves SOVERSION (store/Makefile), which stays 0 through development. test/shared.test.mjs holds this file to
# the header, to src/exports.map and to the built library's dynamic symbols, in both directions.
