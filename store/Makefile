#
# The descriptions store's reader and writer (docs/descriptions-store.md, section 5): libomx-panel-store.so.0 (and a static
# copy for the command), its header, its pkg-config file and the command omx-panel-store. Needs a C11 compiler, SQLite 3.38.0
# or above (STRICT and json_valid; pkg-config sqlite3), cJSON (libcjson) and omx-contract's C domain loader (libomx-domain:
# omx-contract-devel, pkg-config libomx-domain). The schema version and the DDL are compiled in from ../schema/panel.sql, and
# the panel domain's version from ../contract.d/panel/panel.json, so each is held once.
#
#   make [-C store]     build/ : the library, the command, the pkg-config file
#   make check          the tests (node 22 or above: its SQLite builds the fixtures), over the built command
#   make install PREFIX=... DESTDIR=...   the library, its .so link, header and pkg-config file, the command and its page,
#                                         and the DDL as $(DATADIR)/omx-panel-store/panel.sql (compiled in; the copy is for
#                                         a build that makes a store with other tools)

PREFIX ?= /usr/local
LIBDIR ?= $(PREFIX)/lib
INCLUDEDIR ?= $(PREFIX)/include
BINDIR ?= $(PREFIX)/bin
DATADIR ?= $(PREFIX)/share
MANDIR ?= $(DATADIR)/man
PKG_CONFIG ?= pkg-config
VERSION := $(shell sed -n 's/^  "version": "\(.*\)",$$/\1/p' ../package.json)
SQLITE_FLOOR := 3.38.0

B := build
DEPS := sqlite3 libcjson libomx-domain
# the installed plugin-db domain, whose version a new store records: <contractdir>/plugin-db/plugin-db.json, the contract
# directory found as omx-contract's docs/contract-dir.md says, $OMX_CONTRACT_PATH (the first of its directories holding the
# domain), else pkg-config's contractdir of libomx-domain, the one omx-contract package the store builds against (DEPS)
# and whose .pc names it as omx-contract.pc does. None found is refused by name when the store is built.
CONTRACTDIR ?= $(shell $(PKG_CONFIG) --variable=contractdir libomx-domain 2>/dev/null)
PLUGIN_DB_DOMAIN ?= $(firstword $(foreach d,$(subst :, ,$(OMX_CONTRACT_PATH)),$(wildcard $(d)/plugin-db/plugin-db.json)) \
  $(if $(CONTRACTDIR),$(wildcard $(CONTRACTDIR)/plugin-db/plugin-db.json)))
CFLAGS ?= -O2 -g
CFLAGS += -std=c11 -fPIC -fvisibility=hidden -Wall -Wextra -Werror -Iinclude -Isrc -I$(B) $(shell $(PKG_CONFIG) --cflags $(DEPS))
LDLIBS += $(shell $(PKG_CONFIG) --libs $(DEPS))
SOVERSION := 0
SONAME := libomx-panel-store.so.$(SOVERSION)

.PHONY: all check install clean FORCE
all: $(B)/$(SONAME) $(B)/libomx-panel-store.a $(B)/omx-panel-store $(B)/omx-panel-store.pc

$(B):
	mkdir -p $@
# SQLite's floor, checked before anything is compiled against it
$(B)/sqlite-version: FORCE | $(B)
	@$(PKG_CONFIG) --atleast-version=$(SQLITE_FLOOR) sqlite3 || \
	  { echo "the store needs SQLite >= $(SQLITE_FLOOR) (pkg-config sqlite3: $$($(PKG_CONFIG) --modversion sqlite3 2>&1))" >&2; exit 1; }
	@$(PKG_CONFIG) --modversion sqlite3 | cmp -s - $@ || $(PKG_CONFIG) --modversion sqlite3 > $@

# the DDL and its version, and the two domains' versions, each from the file that holds it
$(B)/schema_gen.h: ../schema/panel.sql ../contract.d/panel/panel.json $(PLUGIN_DB_DOMAIN) | $(B)
	@test -n "$(PLUGIN_DB_DOMAIN)" || { \
	  if [ -z "$(OMX_CONTRACT_PATH)$(CONTRACTDIR)" ]; then echo "store: no contract directory: OMX_CONTRACT_PATH is unset and '$(PKG_CONFIG) --variable=contractdir libomx-domain' names none (install libomx-domain-devel)" >&2; \
	  else echo "store: no plugin-db domain (plugin-db/plugin-db.json) in $(or $(OMX_CONTRACT_PATH),$(CONTRACTDIR)): install plugin-db-contract" >&2; fi; exit 1; }
	{ echo '/* generated by store/Makefile from schema/panel.sql and contract.d/panel/panel.json */'; \
	  echo "#define OMX_PANEL_STORE_SCHEMA_VERSION $$(sed -n 's/^PRAGMA user_version = \([0-9][0-9]*\);$$/\1/p' ../schema/panel.sql)"; \
	  echo '#define OMX_PANEL_STORE_PANEL_VERSION "'"$$(sed -n 's/^    "version": "\(.*\)",$$/\1/p' ../contract.d/panel/panel.json | head -n 1)"'"'; \
	  echo '#define OMX_PANEL_STORE_PLUGIN_DB_VERSION "'"$$(sed -n 's/^    "version": "\(.*\)",$$/\1/p' $(PLUGIN_DB_DOMAIN) | head -n 1)"'"'; \
	  echo 'static const char OMX_PANEL_STORE_DDL[] ='; \
	  grep -v '^PRAGMA user_version' ../schema/panel.sql | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/^/  "/' -e 's/$$/\\n"/'; \
	  echo '  ;'; } > $@.tmp
	grep '^#define OMX_PANEL_STORE_SCHEMA_VERSION [0-9]' $@.tmp > /dev/null
	mv $@.tmp $@

$(B)/store.o: src/store.c src/internal.h include/omx-panel/omx_panel_store.h $(B)/schema_gen.h $(B)/sqlite-version | $(B)
	$(CC) $(CFLAGS) -c -o $@ $<
$(B)/cli.o: src/cli.c src/internal.h include/omx-panel/omx_panel_store.h | $(B)
	$(CC) $(CFLAGS) -c -o $@ $<
$(B)/libomx-panel-store.a: $(B)/store.o
	$(AR) rcs $@ $^
$(B)/$(SONAME): $(B)/store.o src/exports.map
	$(CC) $(LDFLAGS) -shared -Wl,-soname,$(SONAME) -Wl,--version-script=src/exports.map -o $@ $(B)/store.o $(LDLIBS)
	ln -sf $(SONAME) $(B)/libomx-panel-store.so
# the command links the static copy: it reaches the places and the writer's rule the shared library does not export
$(B)/omx-panel-store: $(B)/cli.o $(B)/libomx-panel-store.a
	$(CC) $(LDFLAGS) -o $@ $(B)/cli.o $(B)/libomx-panel-store.a $(LDLIBS)
$(B)/omx-panel-store.pc: omx-panel-store.pc.in | $(B)
	sed -e 's|@PREFIX@|$(PREFIX)|' -e 's|@LIBDIR@|$(LIBDIR)|' -e 's|@INCLUDEDIR@|$(INCLUDEDIR)|' -e 's|@VERSION@|$(VERSION)|' $< > $@

check: all
	node --no-warnings --test --test-concurrency=2 test/*.test.mjs

install: all
	install -d $(DESTDIR)$(LIBDIR)/pkgconfig $(DESTDIR)$(INCLUDEDIR)/omx-panel $(DESTDIR)$(BINDIR) $(DESTDIR)$(MANDIR)/man1 $(DESTDIR)$(DATADIR)/omx-panel-store
	install -m 0755 $(B)/$(SONAME) $(DESTDIR)$(LIBDIR)/
	ln -sf $(SONAME) $(DESTDIR)$(LIBDIR)/libomx-panel-store.so
	install -m 0644 include/omx-panel/omx_panel_store.h $(DESTDIR)$(INCLUDEDIR)/omx-panel/
	install -m 0644 $(B)/omx-panel-store.pc $(DESTDIR)$(LIBDIR)/pkgconfig/
	install -m 0755 $(B)/omx-panel-store $(DESTDIR)$(BINDIR)/
	install -m 0644 ../man/omx-panel-store.1 $(DESTDIR)$(MANDIR)/man1/
	install -m 0644 ../schema/panel.sql $(DESTDIR)$(DATADIR)/omx-panel-store/

clean:
	rm -rf $(B)
