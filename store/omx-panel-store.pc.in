prefix=@PREFIX@
libdir=@LIBDIR@
includedir=@INCLUDEDIR@

Name: omx-panel-store
Description: Reads and writes the descriptions store: the base, the system layer and the user layer of panel.sqlite
Version: @VERSION@
Requires.private: sqlite3 libcjson libomx-domain
Cflags: -I${includedir}
Libs: -L${libdir} -lomx-panel-store
