new file mode 100644
index 0000000..a35c797
--- /dev/null
+++ b/renderer/test/meters.test.mjs
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Pau Aliagas <linuxnow@gmail.com>
+/*
+ * The renderer's meters (the one-panel spec §7.9): the description's `meters`, each drawn by omx-dsp's meter view law on the
+ * description's range through omx_panel_view_set_meter. Held by value against the law's TypeScript twin (`@openmixer/omx-dsp`,
+ * meterFillDb, meterMarker, meterClip) and by pixels: a level with clip lights its lamp and keeps it lit until cleared, its marker
+ * falls by elapsed time; a gain reduction fills from the right and has no marker; a meter that declares no clip word, and a foreign
+ * meter (unheld), light nothing whatever the source says. Each rule has its sabotage arm: the input broken, the check read red.
+ */
+import assert from 'node:assert/strict';
+import { execFileSync, spawnSync } from 'node:child_process';
+import { readFileSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { test } from 'node:test';
+import { CLI, DATA, FIXTURES, HAVE_TWIN, compare, descriptionFile, render, rects, scratch, stateFile } from './harness.mjs';
+
+const fx = FIXTURES.find((f) => f.name === 'meters');
+const twin = HAVE_TWIN ? await import('@openmixer/omx-dsp') : null;
+const needTwin = twin ? {} : { skip: 'omx-dsp twin (@openmixer/omx-dsp) not installed' };
+
+/** The fixture's description (edited by `edit`) and a state carrying `meters`, in files. */
+function files(meters = {}, edit = (x) => x) {
+  const dir = scratch();
+  const desc = join(dir, 'm.layout.json');
+  writeFileSync(desc, JSON.stringify(edit(JSON.parse(readFileSync(descriptionFile(fx, dir), 'utf8')))));
+  const state = JSON.parse(readFileSync(stateFile(fx, dir), 'utf8'));
+  state.meters = meters;
+  const st = join(dir, 'm.state.json');
+  writeFileSync(st, JSON.stringify(state));
+  return [desc, st];
+}
+
+/** What each meter draws after the readings: `{ <symbol>: { fill, marker, clip } }`, from the renderer's --meters lines. */
+function readings(meters, edit) {
+  const [desc, st] = files(meters, edit);
+  const out = execFileSync(CLI, ['--description', desc, '--data', DATA, '--state', st, '--rects', '--meters'], { encoding: 'utf8' });
+  return Object.fromEntries(out.split('\n').filter((l) => l.startsWith('meter ')).map((l) => {
+    const [, sym, fill, marker, clip] = l.split(' ');
+    return [sym, { fill: Number(fill), marker: Number(marker), clip: clip === '1' }];
+  }));
+}
+const draw = (meters, edit) => render(...files(meters, edit));
+/** The pixels two images differ at, as [x, y]. */
+function diff(a, b) {
+  const at = [];
+  for (let i = 0; i < a.w * a.h; i++) for (let k = 0; k < 4; k++) if (a.data[i * 4 + k] !== b.data[i * 4 + k]) { at.push([i % a.w, Math.floor(i / a.w)]); break; }
+  return at;
+}
+/** The cell of the control that draws meter `symbol` (the meter cells follow the controls, in the description's order). */
+function cellOf(symbol) {
+  const [desc] = files();
+  const x = JSON.parse(readFileSync(desc, 'utf8'));
+  const symbols = [...x.controls.map((c) => c.symbol), ...x.meters.map((m) => m.symbol).filter((s) => !x.controls.some((c) => c.symbol === s))];
+  return rects(desc)[symbols.indexOf(symbol)];
+}
+const inside = (pts, [x, y, w, h]) => pts.every(([px, py]) => px >= x && px < x + w && py >= y && py < y + h);
+
+test('the description\'s meters are drawn: one per meter, the foreign control among them, in order', () => {
+  assert.deepEqual(Object.keys(readings()), ['compGr', 'compIn', 'compOut', 'compKey', 'peak_out']);
+});
+
+test('a level: the fill and the marker are the view law\'s on the description\'s range, the marker falling by elapsed time', needTwin, () => {
+  const seq = [{ value: 0, dt: 0 }, { value: -40, dt: 0.25 }, { value: -40, dt: 0.25 }, { value: null, dt: 1 }];
+  const got = readings({ compIn: seq }).compIn;
+  // the twin over the same ticks: range [-60, 6] dBFS, the declared fall
+  let mk;
+  for (const r of seq) mk = twin.meterMarker(mk, twin.meterFillDb((r.value ?? -Infinity) - 6, -66), r.dt, twin.METER_VIEW.fallDbPerSecond, -66);
+  assert.ok(Math.abs(got.fill - mk.live) < 1e-12, `fill ${got.fill} against ${mk.live}`);
+  assert.ok(Math.abs(got.marker - mk.marker) < 1e-12, `marker ${got.marker} against ${mk.marker}`);
+  // 1.5 s at 18 dB/s from 0 dBFS: 27 dB down on a 66 dB span
+  assert.ok(Math.abs(got.marker - (60 - 27) / 66) < 1e-12, `${got.marker}`);
+});
+test('sabotage: a marker that does not fall (fall 0) is not what the renderer draws, so the agreement above can go red', needTwin, () => {
+  const seq = [{ value: 0, dt: 0 }, { value: null, dt: 1 }];
+  let mk;
+  for (const r of seq) mk = twin.meterMarker(mk, twin.meterFillDb((r.value ?? -Infinity) - 6, -66), r.dt, 0, -66);
+  assert.ok(Math.abs(readings({ compIn: seq }).compIn.marker - mk.marker) > 0.1);
+});
+
+test('a level with clip: the lamp lights on a clip and stays lit until cleared; it is drawn inside the meter\'s cell', () => {
+  const lit = readings({ compIn: [{ value: 3, clip: true }, { value: -30, dt: 2 }] }).compIn;
+  assert.equal(lit.clip, true, 'lit and held over a later tick with no clip');
+  assert.equal(readings({ compIn: [{ value: 3, clip: true }, { value: -30, dt: 2, clear: true }] }).compIn.clip, false, 'cleared');
+  const on = draw({ compIn: [{ value: -60, clip: true }] }), off = draw({ compIn: [{ value: -60 }] });
+  const d = diff(on, off);
+  assert.ok(d.length > 0, 'the lit lamp is drawn');
+  assert.ok(inside(d, cellOf('compIn')), 'and only inside compIn\'s cell');
+});
+test('sabotage: the same meter described with clip: false never lights, whatever the source says', () => {
+  const noClip = (x) => ({ ...x, meters: x.meters.map((m) => (m.symbol === 'compIn' ? { ...m, clip: false } : m)) });
+  assert.equal(readings({ compIn: [{ value: 3, clip: true }] }, noClip).compIn.clip, false);
+  assert.equal(diff(draw({ compIn: [{ value: -60, clip: true }] }, noClip), draw({ compIn: [{ value: -60 }] }, noClip)).length, 0);
+});
+test('a level that declares no clip word (compKey) has no lamp and lights none', () => {
+  assert.equal(readings({ compKey: [{ value: 0, clip: true }] }).compKey.clip, false);
+  assert.equal(diff(draw({ compKey: [{ value: -60, clip: true }] }), draw({ compKey: [{ value: -60 }] })).length, 0);
+});
+
+test('a gain reduction: its fill runs down from max on its range, from the right of its frame, with no marker or fall', needTwin, () => {
+  const got = readings({ compGr: [{ value: -12, dt: 0 }, { value: -6, dt: 1 }] }).compGr;
+  assert.ok(Math.abs(got.fill - twin.meterFillDb(-24 + 6, -24)) < 1e-12 && Math.abs(got.fill - 0.25) < 1e-12, `${got.fill}`);
+  assert.equal(got.marker, got.fill, 'no marker of its own: the reader recovers a reduction');
+  const [x, , w] = cellOf('compGr');
+  const d = diff(draw({ compGr: [{ value: -6 }] }), draw({ compGr: [{ value: 0 }] }));
+  assert.ok(d.length > 0 && d.every(([px]) => px >= x + w / 2), `a quarter of the way in from the right of the cell at x ${x}..${x + w}`);
+});
+test('sabotage: the same reduction read as a level fills from the left, and the check above goes red', () => {
+  const asLevel = (y) => ({ ...y, meters: y.meters.map((m) => (m.symbol === 'compGr' ? { ...m, kind: 'level', measurement: 'peak' } : m)) });
+  const [x, , w] = cellOf('compGr');
+  const d = diff(draw({ compGr: [{ value: -6 }] }, asLevel), draw({ compGr: [{ value: -24 }] }, asLevel));
+  assert.ok(d.some(([px]) => px < x + w / 2));
+});
+
+test('a foreign meter (a read-only level control) is unheld: its caption says so, and a clip from its source lights nothing', () => {
+  assert.equal(readings({ peak_out: [{ value: 0, clip: true }] }).peak_out.clip, false);
+  const held = (y) => ({ ...y, meters: y.meters.map((m) => (m.symbol === 'peak_out' ? { ...m, held: true } : m)) });
+  const d = diff(draw({}), draw({}, held));
+  assert.ok(d.length > 0, 'the caption changes with held: "dB unheld" against "dB"');
+  assert.ok(inside(d, cellOf('peak_out')));
+});
+
+test('refused by code: a meter whose range is not min below max, or a reading for no meter, draws nothing', () => {
+  const [desc, st] = files({}, (y) => ({ ...y, meters: y.meters.map((m) => (m.symbol === 'compIn' ? { ...m, min: 6, max: 6 } : m)) }));
+  const r = spawnSync(CLI, ['--description', desc, '--data', DATA, '--state', st, '--rects'], { encoding: 'utf8' });
+  assert.equal(r.status, 1);
+  assert.match(r.stderr, /meter 'compIn' lacks .* a range of min below max/);
+  const [d2, s2] = files({ nosuch: [{ value: 0 }] });
+  const r2 = spawnSync(CLI, ['--description', d2, '--data', DATA, '--state', s2, '--rects'], { encoding: 'utf8' });
+  assert.equal(r2.status, 1);
+  assert.match(r2.stderr, /no meter of the panel/);
+});
