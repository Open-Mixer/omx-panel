export DEB_BUILD_MAINT_OPTIONS = hardening=+all
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk
include /usr/share/dpkg/architecture.mk

%:
	dh $@

# npm ci fetches typescript (the build) and ajv (the validator, installed with the package); the vendored source
# tarball (tools/vendored-source.sh) already holds them, for a build with no registry
override_dh_auto_build:
	test -d node_modules || npm ci --no-audit --no-fund
	dh_auto_build
	$(MAKE) -C renderer WINDOW=0 PREFIX=/usr LIBDIR=/usr/lib/$(DEB_HOST_MULTIARCH) INCLUDEDIR=/usr/include DATADIR=/usr/share

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	make test
endif

override_dh_auto_install:
	dh_auto_install --destdir=debian/omx-panel -- PREFIX=/usr BINDIR=/usr/bin DATADIR=/usr/share UNITDIR=/usr/lib/systemd/system SYSCONFDIR=/etc
	# the renderer's shared library, header, link and pkg-config file, split by debian/libomx-panel-render*.install
	$(MAKE) install-renderer DESTDIR=$(CURDIR)/debian/tmp PREFIX=/usr LIBDIR=/usr/lib/$(DEB_HOST_MULTIARCH) INCLUDEDIR=/usr/include BINDIR=/usr/bin DATADIR=/usr/share
	# the vendored modules' lint and VCS dotfiles are theirs, not the package's: lintian refuses .eslintrc.yml
	find debian/omx-panel/usr/share/omx-panel -path '*/node_modules/*' -name '.*' -type f -delete
	# the catalogs are the language packs' (debian/omx-panel-l10n-<lang>.install takes them from debian/tmp)
	install -d debian/tmp/usr/share/omx-panel/catalogs
	mv debian/omx-panel/usr/share/omx-panel/catalogs/*.json debian/tmp/usr/share/omx-panel/catalogs/

# the sync units are installed, never enabled or started by the package: `systemctl enable omx-modgui-sync` (and
# omx-complement-sync) is the choice; so an upgrade has nothing of ours to stop either, and on a host that never had the
# unit the stop only prints an error
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start --no-stop-on-upgrade
