export DEB_BUILD_MAINT_OPTIONS = hardening=+all
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk
include /usr/share/dpkg/architecture.mk

%:
	dh $@

# npm ci fetches typescript (the build) and ajv (the validator, installed with the package); the vendored source
# tarball (tools/vendored-source.sh) already holds them, for a build with no registry
override_dh_auto_build:
	test -d node_modules || npm ci --no-audit --no-fund
	$(MAKE) link-packaged PREFIX=/usr DATADIR=/usr/share
	dh_auto_build
	$(MAKE) -C renderer WINDOW=0 PREFIX=/usr LIBDIR=/usr/lib/$(DEB_HOST_MULTIARCH) INCLUDEDIR=/usr/include DATADIR=/usr/share
	$(MAKE) -C store PREFIX=/usr LIBDIR=/usr/lib/$(DEB_HOST_MULTIARCH) INCLUDEDIR=/usr/include
	# the descriptions store's base, from base/inputs/ (docs/descriptions-store.md 6)
	$(MAKE) base

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	OMX_PANEL_SHAPES=packaged OMX_CONTRACT_CLI=/usr/lib/omx-contract/bin/omx-contract.mjs make test
endif

override_dh_auto_install:
	dh_auto_install --destdir=debian/omx-panel -- PREFIX=/usr BINDIR=/usr/bin DATADIR=/usr/share UNITDIR=/usr/lib/systemd/system SYSCONFDIR=/etc
	# the Python shapes, omx_panel.shapes.<name>, in their own package
	$(MAKE) install-python DESTDIR=$(CURDIR)/debian/python3-omx-panel PREFIX=/usr PYTHONDIR=/usr/lib/python3/dist-packages
	# the renderer's shared library, header, link and pkg-config file, split by debian/libomx-panel-render*.install
	$(MAKE) install-renderer DESTDIR=$(CURDIR)/debian/tmp PREFIX=/usr LIBDIR=/usr/lib/$(DEB_HOST_MULTIARCH) INCLUDEDIR=/usr/include BINDIR=/usr/bin DATADIR=/usr/share
	# the descriptions store: library, development files and command, split by debian/libomx-panel-store*.install and
	# debian/omx-panel-store.install
	$(MAKE) install-store DESTDIR=$(CURDIR)/debian/tmp PREFIX=/usr LIBDIR=/usr/lib/$(DEB_HOST_MULTIARCH) INCLUDEDIR=/usr/include BINDIR=/usr/bin DATADIR=/usr/share MANDIR=/usr/share/man
	# the base, for omx-panel-descriptions (debian/omx-panel-descriptions.install)
	$(MAKE) install-base DESTDIR=$(CURDIR)/debian/tmp DATADIR=/usr/share
	# the vendored modules' lint and VCS dotfiles are theirs, not the package's: lintian refuses .eslintrc.yml
	find debian/omx-panel/usr/share/omx-panel -path '*/node_modules/*' -name '.*' -type f -delete
	# the catalogs are the language packs' (debian/omx-panel-l10n-<lang>.install takes them from debian/tmp)
	install -d debian/tmp/usr/share/omx-panel/catalogs
	mv debian/omx-panel/usr/share/omx-panel/catalogs/*.json debian/tmp/usr/share/omx-panel/catalogs/
	# the panel and gestures domains are omx-panel-contract's (debian/omx-panel-contract.install takes them from debian/tmp)
	install -d debian/tmp/usr/share/omx-contract/contract.d
	mv debian/omx-panel/usr/share/omx-contract/contract.d/panel debian/tmp/usr/share/omx-contract/contract.d/
	mv debian/omx-panel/usr/share/omx-contract/contract.d/gestures debian/tmp/usr/share/omx-contract/contract.d/
	# and the panel domain's codes header (row V1)
	install -d debian/tmp/usr/include/omxdomain
	mv debian/omx-panel/usr/include/omxdomain/panel_codes.h debian/tmp/usr/include/omxdomain/
	rmdir -p --ignore-fail-on-non-empty debian/omx-panel/usr/include/omxdomain
	rmdir -p --ignore-fail-on-non-empty debian/omx-panel/usr/share/omx-contract/contract.d
	# the tools as the omx-panel package installs them load and run: their @openmixer/omx-contract resolves through the
	# package's own node_modules (debian/tests/installed-tools runs the same check on an installed host); the panel domain
	# they open at load is the one this build moved to debian/tmp for omx-panel-contract (none is installed here)
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	tools/installed-tools-check.sh $(CURDIR)/debian/omx-panel/usr/share/omx-panel $(CURDIR)/debian/tmp/usr/share/omx-contract/contract.d
endif

# the one pass's unit is enabled by default where systemd exists (docs/descriptions-store.md 14, 5) and never started
# by the package: it runs at boot and after each plugin-qualify sync; an upgrade has nothing of ours to stop
override_dh_installsystemd:
	dh_installsystemd --no-start --no-stop-on-upgrade
